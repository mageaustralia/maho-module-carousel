    <script type="text/javascript">
    //<![CDATA[
    var slideManager = {
        uploadUrl: '<?= $this->getUploadUrl() ?>',
        saveUrl: '<?= $this->getSaveSlideUrl() ?>',
        deleteUrl: '<?= $this->getDeleteSlideUrl() ?>',
        updateOrderUrl: '<?= $this->getUpdateOrderUrl() ?>',
        draggedElement: null,

        init: function() {
            var self = this;

            // Initialize drag and drop with vanilla JS
            var slideItems = document.querySelectorAll('.slide-item');
            var container = document.getElementById('slides-grid');

            if (container && slideItems.length > 0) {
                slideItems.forEach(function(item) {
                    var handle = item.querySelector('.slide-handle');
                    if (handle) {
                        handle.addEventListener('mousedown', function(e) {
                            self.startDrag(e, item);
                        });
                    }
                });
            }

            console.log('Drag and drop initialized with vanilla JS');
        },

        startDrag: function(e, element) {
            e.preventDefault();
            var self = this;
            this.draggedElement = element;

            // Add dragging class
            element.classList.add('dragging');
            element.style.opacity = '0.5';

            var startY = e.clientY;
            var startTop = element.offsetTop;

            function onMouseMove(e) {
                var deltaY = e.clientY - startY;
                var siblings = Array.from(element.parentNode.children).filter(el => el !== element && el.classList.contains('slide-item'));

                siblings.forEach(function(sibling) {
                    var rect = sibling.getBoundingClientRect();
                    var elementRect = element.getBoundingClientRect();

                    if (elementRect.top < rect.top && elementRect.bottom > rect.top) {
                        sibling.parentNode.insertBefore(element, sibling.nextSibling);
                    } else if (elementRect.top < rect.bottom && elementRect.bottom > rect.bottom) {
                        sibling.parentNode.insertBefore(element, sibling);
                    }
                });
            }

            function onMouseUp() {
                element.classList.remove('dragging');
                element.style.opacity = '';
                document.removeEventListener('mousemove', onMouseMove);
                document.removeEventListener('mouseup', onMouseUp);
                self.updateOrder();
            }

            document.addEventListener('mousemove', onMouseMove);
            document.addEventListener('mouseup', onMouseUp);
        },

        openAddDialog: function() {
            this.openDialog();
        },

        editSlide: function(slideId) {
            var slide = this.getSlideData(slideId);
            if (slide) {
                this.openDialog(slide);
            }
        },

        openDialog: function(slideData) {
            var self = this;
            var dialog = document.getElementById('slide-dialog');

            // Reset form
            document.getElementById('slide-form').reset();
            document.getElementById('current-image').innerHTML = '';

            if (slideData) {
                document.getElementById('slide_id').value = slideData.slide_id;
                document.getElementById('slide_title').value = slideData.title || '';
                document.getElementById('slide_subtitle').value = slideData.subtitle || '';
                document.getElementById('slide_link_url').value = slideData.link_url || '';
                document.getElementById('slide_button_text').value = slideData.button_text || '';
                document.getElementById('slide_button_style').value = slideData.button_style || 'btn-primary';
                document.getElementById('slide_custom_html').value = slideData.custom_html || '';
                document.getElementById('slide_text_width').value = slideData.text_width || '';
                document.getElementById('slide_text_alignment').value = slideData.text_alignment || 'center';
                document.getElementById('slide_sort_order').value = slideData.sort_order || '0';
                document.getElementById('slide_status').value = slideData.status || '1';

                if (slideData.image) {
                    document.getElementById('current-image').innerHTML = '<p>Current image:</p><img src="' + slideData.image_url + '" alt="">';
                }
            }

            // Show the dialog using Maho admin modal
            dialog.style.display = 'block';

            // Create overlay
            var overlay = document.createElement('div');
            overlay.className = 'modal-overlay';
            overlay.style.cssText = 'position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.5);z-index:999;';
            document.body.appendChild(overlay);

            // Position dialog
            dialog.style.cssText = 'position:fixed;top:50%;left:50%;transform:translate(-50%,-50%);background:white;padding:20px;border:1px solid #ccc;box-shadow:0 4px 8px rgba(0,0,0,0.2);z-index:1000;width:600px;max-height:80vh;overflow-y:auto;';

            // Add title and buttons if not present
            if (!dialog.querySelector('.dialog-header')) {
                var header = document.createElement('div');
                header.className = 'dialog-header';
                header.innerHTML = '<h2>' + (slideData ? 'Edit Slide' : 'Add New Slide') + '</h2>';
                dialog.insertBefore(header, dialog.firstChild);

                var buttons = document.createElement('div');
                buttons.className = 'dialog-buttons';
                buttons.style.cssText = 'margin-top:20px;text-align:right;';
                buttons.innerHTML = '<button type="button" onclick="slideManager.saveSlide()" class="scalable save"><span>Save</span></button> ' +
                                   '<button type="button" onclick="slideManager.closeDialog()" class="scalable"><span>Cancel</span></button>';
                dialog.appendChild(buttons);
            }

            overlay.onclick = function() { self.closeDialog(); };
        },

        closeDialog: function() {
            var dialog = document.getElementById('slide-dialog');
            var overlay = document.querySelector('.modal-overlay');
            if (dialog) dialog.style.display = 'none';
            if (overlay) overlay.remove();
        },

        saveSlide: function() {
            var form = document.getElementById('slide-form');
            var formData = new FormData(form);
            var self = this;

            // Add form_key for MAHO CSRF protection
            if (typeof FORM_KEY !== 'undefined') {
                formData.append('form_key', FORM_KEY);
            }

            console.log('Saving slide with URL:', this.saveUrl);

            var xhr = new XMLHttpRequest();
            xhr.open('POST', this.saveUrl, true);
            xhr.onload = function() {
                console.log('Response status:', xhr.status);
                console.log('Response text:', xhr.responseText);

                if (xhr.status === 200) {
                    try {
                        var response = JSON.parse(xhr.responseText);
                        if (response.success) {
                            location.reload();
                        } else {
                            alert(response.message || 'Error saving slide');
                        }
                    } catch(e) {
                        console.error('JSON parse error:', e);
                        console.log('Raw response:', xhr.responseText);
                        alert('Error saving slide: Invalid response format');
                    }
                } else {
                    alert('Error saving slide: HTTP ' + xhr.status);
                }
            };
            xhr.onerror = function() {
                console.error('Network error');
                alert('Error saving slide: Network error');
            };
            xhr.send(formData);
        },

        deleteSlide: function(slideId) {
            if (!confirm('Are you sure you want to delete this slide?')) {
                return;
            }

            var xhr = new XMLHttpRequest();
            xhr.open('POST', this.deleteUrl, true);
            xhr.setRequestHeader('Content-Type', 'application/x-www-form-urlencoded');
            xhr.onload = function() {
                if (xhr.status === 200) {
                    try {
                        var response = JSON.parse(xhr.responseText);
                        if (response.success) {
                            location.reload();
                        } else {
                            alert(response.message || 'Error deleting slide');
                        }
                    } catch(e) {
                        alert('Error deleting slide');
                    }
                } else {
                    alert('Error deleting slide');
                }
            };
            xhr.onerror = function() {
                alert('Error deleting slide');
            };
            xhr.send('slide_id=' + encodeURIComponent(slideId) + '&form_key=' + encodeURIComponent(FORM_KEY));
        },

        updateOrder: function() {
            var order = [];
            var slideItems = document.querySelectorAll('.slide-item');
            slideItems.forEach(function(item, index) {
                order.push({
                    slide_id: item.getAttribute('data-slide-id'),
                    sort_order: index
                });
            });

            var xhr = new XMLHttpRequest();
            xhr.open('POST', this.updateOrderUrl, true);
            xhr.setRequestHeader('Content-Type', 'application/json');
            xhr.onload = function() {
                if (xhr.status === 200) {
                    try {
                        var response = JSON.parse(xhr.responseText);
                        if (!response.success) {
                            alert('Error updating slide order');
                        }
                    } catch(e) {
                        console.error('Error parsing response');
                    }
                }
            };
            xhr.send(JSON.stringify({
                order: order,
                form_key: FORM_KEY
            }));
        },

        getSlideData: function(slideId) {
            var slideData = null;
            var xhr = new XMLHttpRequest();
            xhr.open('GET', '<?= $this->getUrl('*/*/getSlide') ?>?slide_id=' + encodeURIComponent(slideId), false); // Synchronous for simplicity
            xhr.send();

            if (xhr.status === 200) {
                try {
                    var response = JSON.parse(xhr.responseText);
                    if (response.success) {
                        slideData = response.slide;
                    }
                } catch(e) {
                    console.error('Error parsing slide data');
                }
            }
            return slideData;
        }
    };

    // Initialize when DOM is ready
    document.addEventListener('DOMContentLoaded', function() {
        slideManager.init();
    });
    //]]>
    </script>
<?php endif; ?>