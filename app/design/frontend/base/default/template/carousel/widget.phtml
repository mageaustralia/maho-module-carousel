<?php
/**
 * Self-contained carousel widget (Option B) - works on any Maho theme, including
 * classic base/default. No framework (Tailwind/DaisyUI) dependency: it uses the
 * bundled skin css/carousel/carousel.css + js/carousel/carousel.js.
 *
 * Tailwind/DaisyUI themes may override this template (see docs/examples).
 *
 * @var Mageaustralia_Carousel_Block_Widget $this
 */
$carousel = $this->getCarousel();
if (!$carousel || !$carousel->getId() || !$carousel->getStatus()) {
    return;
}
$slides = $this->getSlides();
if (count($slides) === 0) {
    return;
}

$htmlId   = $this->getCarouselHtmlId();
$count    = count($slides);
$autoplay = $carousel->getAutoplay() ? (int) $carousel->getAutoplaySpeed() : 0;
$showNav  = $count > 1 && $carousel->getShowNavigation();
$showDots = $count > 1 && $carousel->getShowDots();
$height   = $carousel->getHeight();

$flexMap  = ['top' => 'flex-start', 'center' => 'center', 'bottom' => 'flex-end', 'left' => 'flex-start', 'right' => 'flex-end'];
$alignMap = ['left' => 'left', 'center' => 'center', 'right' => 'right'];

// Constrain admin-authored values that land in inline style="..." declarations
// to a safe character set, so a stray ";" / "(" cannot inject extra CSS
// declarations (e.g. background:url(...)) even though the source is trusted.
$cssToken = static fn(string $v): string => preg_replace('/[^a-zA-Z0-9#%.,()\s\-]/', '', $v);

$i = 0;
?>
<div class="mhc" id="<?= $this->escapeHtml($htmlId) ?>" data-mhc data-mhc-autoplay="<?= (int) $autoplay ?>"<?php if ($height): ?> style="--mhc-h:<?= $this->escapeHtml($cssToken((string) $height)) ?>"<?php endif; ?>>
    <div class="mhc__viewport">
        <div class="mhc__track">
            <?php foreach ($slides as $slide): ?>
                <?php
                $parts     = explode('-', (string) ($slide->getTextPosition() ?: 'center-left'));
                $vert      = $flexMap[$parts[0] ?? 'center'] ?? 'center';
                $horiz     = $flexMap[$parts[1] ?? 'left'] ?? 'flex-start';
                $align     = (string) ($slide->getTextAlignment() ?: 'left');
                $textAlign = $alignMap[$align] ?? 'left';
                $color     = (string) ($slide->getTextColor() ?: '#ffffff');
                $colorCss  = str_contains($color, 'white') ? '#ffffff' : (str_contains($color, 'black') ? '#000000' : $color);
                $width     = (string) ($slide->getTextWidth() ?: '50%');
                $overlay   = max(0, min(100, (int) $slide->getOverlayOpacity()));
                $buttons   = $slide->getButtons();
                $hasText   = $slide->getTitle() || $slide->getSubtitle() || !empty($buttons);
                $sources   = $this->getImageSources($slide);
                $loading   = $i === 0 ? 'eager' : 'lazy';
                $btnJustify = $textAlign === 'center' ? 'center' : ($textAlign === 'right' ? 'flex-end' : 'flex-start');
                ?>
                <div class="mhc__slide"<?= $i === 0 ? ' data-active' : '' ?>>
                    <?php if ($slide->getCustomHtml()): ?>
                        <?= Mage::helper('cms')->getBlockTemplateProcessor()->filter((string) $slide->getCustomHtml()) ?>
                    <?php else: ?>
                        <picture class="mhc__pic">
                            <?php foreach ($sources as $source): ?>
                                <?php if (!empty($source['srcset'])): ?>
                                    <source srcset="<?= $this->escapeUrl($source['srcset']) ?>" type="<?= $this->escapeHtml($source['type']) ?>">
                                <?php endif; ?>
                            <?php endforeach; ?>
                            <img class="mhc__img" src="<?= $this->escapeUrl($slide->getImageUrl()) ?>" alt="<?= $this->escapeHtml($slide->getTitle()) ?>" loading="<?= $loading ?>">
                        </picture>
                        <?php if ($overlay > 0): ?>
                            <div class="mhc__overlay" style="opacity:<?= $overlay / 100 ?>"></div>
                        <?php endif; ?>
                        <?php if ($hasText): ?>
                            <div class="mhc__caption" style="justify-content:<?= $vert ?>;align-items:<?= $horiz ?>">
                                <div class="mhc__inner" style="max-width:min(<?= $this->escapeHtml($cssToken($width)) ?>,calc(100% - 4rem));text-align:<?= $textAlign ?>;color:<?= $this->escapeHtml($cssToken($colorCss)) ?>">
                                    <?php if ($slide->getTitle()): ?><h2 class="mhc__title"><?= $this->escapeHtml($slide->getTitle()) ?></h2><?php endif; ?>
                                    <?php if ($slide->getSubtitle()): ?><p class="mhc__subtitle"><?= $this->escapeHtml($slide->getSubtitle()) ?></p><?php endif; ?>
                                    <?php if (!empty($buttons)): ?>
                                        <div class="mhc__buttons" style="justify-content:<?= $btnJustify ?>">
                                            <?php foreach ($buttons as $button): ?>
                                                <a class="mhc__btn" href="<?= $this->escapeUrl($button['url'] ?? '#') ?>"><?= $this->escapeHtml($button['text'] ?? '') ?></a>
                                            <?php endforeach; ?>
                                        </div>
                                    <?php endif; ?>
                                </div>
                            </div>
                        <?php endif; ?>
                    <?php endif; ?>
                </div>
                <?php $i++; ?>
            <?php endforeach; ?>
        </div>
    </div>
    <?php if ($showNav): ?>
        <button type="button" class="mhc__nav mhc__nav--prev" aria-label="Previous slide">&#10094;</button>
        <button type="button" class="mhc__nav mhc__nav--next" aria-label="Next slide">&#10095;</button>
    <?php endif; ?>
    <?php if ($showDots): ?>
        <div class="mhc__dots">
            <?php for ($d = 0; $d < $count; $d++): ?>
                <button type="button" class="mhc__dot<?= $d === 0 ? ' is-active' : '' ?>" data-index="<?= $d ?>" aria-label="Go to slide <?= $d + 1 ?>"></button>
            <?php endfor; ?>
        </div>
    <?php endif; ?>
</div>
